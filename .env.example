# Azure OpenAI / Foundry
AZURE_OPENAI_ENDPOINT=https://devrel-aim-resource.cognitiveservices.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-5-nano
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_API_KEY=<your-api-key>

# Optional: OTel exporters (set either or both to enable tracing)
# APPLICATIONINSIGHTS_CONNECTION_STRING=<your-connection-string>
# NEW_RELIC_LICENSE_KEY=<your-ingest-license-key>
# NEW_RELIC_OTLP_ENDPOINT=https://otlp.nr-data.net:4318/v1/traces  # EU: otlp.eu01.nr-data.net

# Enable GenAI span content recording (prompts + completions visible in Foundry Tracing + NR)
# ENABLE_SENSITIVE_DATA=true
# AZURE_TRACING_GEN_AI_CONTENT_RECORDING_ENABLED=true

# New Relic Python Agent (APM)
# NEW_RELIC_APP_NAME=maf-incident-triage
# NEW_RELIC_LICENSE_KEY=<same-key-as-above>

# Optional: SSL (set true if behind corporate proxy)
# AZURE_OPENAI_DISABLE_SSL=true
